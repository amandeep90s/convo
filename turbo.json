{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_VERSION",
        "API_BASE_URL",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "JWT_ACCESS_TOKEN_TTL",
        "JWT_REFRESH_TOKEN_TTL",
        "JWT_SECRET",
        "JWT_TOKEN_AUDIENCE",
        "JWT_TOKEN_ISSUER",
        "LOG_LEVEL",
        "NODE_ENV",
        "PORT",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "WEB_URL",
        "EMAIL_VERIFICATION_TOKEN_TTL",
        "THROTTLE_LIMIT",
        "THROTTLE_TTL",
        "UPLOAD_DIR",
        "REDIS_HOST",
        "REDIS_PORT"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "env": ["CI", "PORT"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["CI", "PORT"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI", "E2E_ALL_BROWSERS", "PORT", "DATABASE_URL", "REDIS_HOST", "REDIS_PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_BASE_URL"],
      "dependsOn": ["^build"]
    }
  }
}
