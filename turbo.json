{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_VERSION",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "JWT_ACCESS_TOKEN_TTL",
        "JWT_REFRESH_TOKEN_TTL",
        "JWT_SECRET",
        "JWT_TOKEN_AUDIENCE",
        "JWT_TOKEN_ISSUER",
        "LOG_LEVEL",
        "NODE_ENV",
        "PORT",
        "RESEND_API_KEY",
        "MAIL_FROM",
        "WEB_URL",
        "EMAIL_VERIFICATION_TOKEN_TTL",
        "THROTTLE_LIMIT",
        "THROTTLE_TTL",
        "REDIS_HOST",
        "REDIS_PORT"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["CI", "PORT"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["^lint:fix"],
      "env": ["CI", "PORT"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI", "E2E_ALL_BROWSERS", "PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
