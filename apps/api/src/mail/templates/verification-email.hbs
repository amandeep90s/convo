<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your Convo email address</title>
  </head>
  <body style="margin:0;background:#f4f7f6;color:#14201d;font-family:Arial,sans-serif;">
    <div style="padding:40px 16px;">
      <table role="presentation" style="width:100%;max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #dfe8e4;border-radius:12px;">
        <tr><td style="padding:40px;">
          <p style="margin:0 0 24px;color:#17805c;font-size:20px;font-weight:700;">Convo</p>
          <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;">Verify your email address</h1>
          <p style="margin:0 0 24px;font-size:16px;line-height:1.6;">Hi {{recipientName}}, confirm your email address to finish creating your Convo account.</p>
          <p style="margin:0 0 28px;"><a href="{{verificationUrl}}" style="display:inline-block;padding:13px 22px;background:#17805c;color:#ffffff;text-decoration:none;border-radius:7px;font-weight:700;">Verify email</a></p>
          <p style="margin:0;color:#5c6d67;font-size:14px;line-height:1.6;">This link expires in {{expiresIn}}. If you did not create this account, you can ignore this email.</p>
        </td></tr>
      </table>
    </div>
  </body>
</html>