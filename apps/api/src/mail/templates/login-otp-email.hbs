<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Your Convo login code</title>
  </head>
  <body style="margin:0;background:#f4f7f6;color:#14201d;font-family:Arial,sans-serif;">
    <div style="padding:40px 16px;">
      <table role="presentation" style="width:100%;max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #dfe8e4;border-radius:12px;">
        <tr><td style="padding:40px;">
          <p style="margin:0 0 24px;color:#17805c;font-size:20px;font-weight:700;">Convo</p>
          <h1 style="margin:0 0 16px;font-size:28px;line-height:1.2;">Your login code</h1>
          <p style="margin:0 0 20px;font-size:16px;line-height:1.6;">Hi {{recipientName}}, use this code to sign in to Convo:</p>
          <p style="margin:0 0 24px;padding:16px;background:#f4f7f6;border-radius:8px;text-align:center;font-size:32px;font-weight:700;letter-spacing:8px;">{{code}}</p>
          <p style="margin:0;color:#5c6d67;font-size:14px;line-height:1.6;">This code expires in {{expiresIn}} and can only be used once. If you did not request it, you can ignore this email.</p>
        </td></tr>
      </table>
    </div>
  </body>
</html>
